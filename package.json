{
  "name": "accounting",
  "private": true,
  "description": "個人記帳 PWA + Cloudflare Worker 後端",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate:local": "npm run db:migrate:local -w apps/api",
    "deploy": "npm run build && npm run deploy -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "rollup": "npm:@rollup/wasm-node@^4.68.8",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "rollup": "$rollup"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true
  }
}
