{
  "name": "@accounting/api",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('fs').mkdirSync('../web/dist',{recursive:true})\"",
    "dev": "wrangler dev --port 8787 --test-scheduled",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "hono": "^4.13.19",
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "wrangler": "^4.166.0"
  }
}
